# 复制为 .env 后填入自己的密钥：cp .env.example .env
# .env 已在 .gitignore 里，不会被提交

# ============ 大模型：对话与意图解析 ============
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT=5
LLM_TOTAL_BUDGET=30

# ============ 向量化：文本 → 向量 ============
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH=32

# ============ 视觉：图片自动生成文字描述 ============
GPT_API_KEY=
GPT_BASE_URL=https://api.openai.com/v1
GPT_MODEL=gpt-6.1-terra
VISION_TIMEOUT=120

# ============ 数据落盘位置 ============
# 留空 = 用 backend/ 下的默认路径（本地开发）
# 容器里由 docker-compose.yml 注入 /app/data/...，这里不用改
# DB_PATH=
# CHROMA_DIR=
# DATABASE_URL=

# ============ 仅 docker compose 使用 ============
POSTGRES_PASSWORD=portfolio_dev_password
